generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Locale {
  EN
  HI
  BILINGUAL
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum OtpPurpose {
  LOGIN
}

enum FinancialYearStatus {
  OPEN
  CLOSED
}

enum PartyType {
  CUSTOMER
  SUPPLIER
}

enum LedgerType {
  GENERAL
  CASH
  BANK
  TAX
  INCOME
  EXPENSE
  PARTY
}

enum AccountNature {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum VoucherType {
  OPENING_BALANCE
  JOURNAL
  SALES
  PURCHASE
  PAYMENT
  RECEIPT
  CONTRA
}

enum VoucherStatus {
  POSTED
  CANCELLED
}

enum InventoryMovementType {
  OPENING
  PURCHASE
  SALES
  SALES_RETURN
  PURCHASE_RETURN
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  PRODUCTION_IN
  PRODUCTION_OUT
  JOB_WORK_IN
  JOB_WORK_OUT
}

enum InventoryDirection {
  IN
  OUT
}

model User {
  id                 String               @id @default(cuid())
  email              String               @unique
  normalizedEmail    String               @unique
  name               String?
  mobile             String?              @unique
  passwordHash       String
  locale             Locale               @default(EN)
  emailVerifiedAt    DateTime?
  failedLoginCount   Int                  @default(0)
  lockedUntil        DateTime?
  sessionVersion     Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  memberships        Membership[]
  resetTokens        PasswordResetToken[]
  otpChallenges      OtpChallenge[]
  auditLogs          AuditLog[]           @relation("AuditActor")
  loginHistory       LoginHistory[]
  authSessions       AuthSession[]
  accountingVouchers AccountingVoucher[]  @relation("VoucherCreator")
  inventoryMovements InventoryMovement[]  @relation("InventoryMovementCreator")

  @@index([mobile])
}

model Company {
  id                      String               @id @default(cuid())
  name                    String
  legalName               String?
  gstin                   String?              @unique
  pan                     String?
  addressLine1            String?
  addressLine2            String?
  city                    String?
  state                   String?
  stateCode               String?
  postalCode              String?
  country                 String               @default("India")
  email                   String?
  phone                   String?
  website                 String?
  logoUrl                 String?
  booksBeginningDate      DateTime?            @db.Date
  financialYearStartMonth Int                  @default(4)
  timezone                String               @default("Asia/Kolkata")
  currency                String               @default("INR")
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  memberships             Membership[]
  roles                   Role[]
  financialYears          FinancialYear[]
  auditLogs               AuditLog[]
  rateLimits              RateLimit[]
  parties                 Party[]
  ledgerGroups            LedgerGroup[]
  ledgers                 Ledger[]
  accountingVouchers      AccountingVoucher[]
  stockGroups             StockGroup[]
  units                   UnitOfMeasure[]
  unitConversions         UnitConversion[]
  stockItems              StockItem[]
  warehouses              Warehouse[]
  batches                 InventoryBatch[]
  stockBalances           StockBalance[]
  inventoryMovements      InventoryMovement[]
  itemConversions         ItemUnitConversion[]

  @@index([name])
  @@index([pan])
  @@index([stateCode])
}

model FinancialYear {
  id                 String              @id @default(cuid())
  companyId          String
  name               String
  startDate          DateTime            @db.Date
  endDate            DateTime            @db.Date
  booksBeginningDate DateTime            @db.Date
  status             FinancialYearStatus @default(OPEN)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, startDate])
  @@index([companyId, status, startDate])
  @@index([companyId, endDate])
}

model Party {
  id               String    @id @default(cuid())
  companyId        String
  type             PartyType
  name             String
  contactName      String?
  email            String?
  phone            String?
  mobile           String?
  gstin            String?
  pan              String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  stateCode        String?
  postalCode       String?
  country          String    @default("India")
  creditPeriodDays Int       @default(0)
  creditLimit      Decimal   @default(0) @db.Decimal(18, 2)
  isActive         Boolean   @default(true)
  creationKey      String
  creationHash     String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ledger           Ledger?

  @@unique([companyId, id])
  @@unique([companyId, creationKey])
  @@unique([companyId, gstin])
  @@index([companyId, type, isActive, name])
  @@index([companyId, pan])
  @@index([companyId, stateCode])
}

model LedgerGroup {
  id        String        @id @default(cuid())
  companyId String
  parentId  String?
  name      String
  code      String
  nature    AccountNature
  isSystem  Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent    LedgerGroup?  @relation("LedgerGroupTree", fields: [companyId, parentId], references: [companyId, id], onDelete: Restrict)
  children  LedgerGroup[] @relation("LedgerGroupTree")
  ledgers   Ledger[]

  @@unique([companyId, id])
  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId, parentId])
  @@index([companyId, nature])
}

model Ledger {
  id                String        @id @default(cuid())
  companyId         String
  groupId           String
  partyId           String?
  name              String
  code              String?
  type              LedgerType    @default(GENERAL)
  isSystem          Boolean       @default(false)
  costCentreEnabled Boolean       @default(false)
  interestEnabled   Boolean       @default(false)
  interestRate      Decimal?      @db.Decimal(7, 4)
  isActive          Boolean       @default(true)
  creationKey       String
  creationHash      String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  group             LedgerGroup   @relation(fields: [companyId, groupId], references: [companyId, id], onDelete: Restrict)
  party             Party?        @relation(fields: [companyId, partyId], references: [companyId, id], onDelete: Restrict)
  voucherLines      VoucherLine[]

  @@unique([companyId, id])
  @@unique([companyId, name])
  @@unique([companyId, code])
  @@unique([companyId, partyId])
  @@unique([companyId, creationKey])
  @@index([companyId, groupId, isActive, name])
  @@index([companyId, type, isActive])
}

model AccountingVoucher {
  id                 String              @id @default(cuid())
  companyId          String
  voucherNumber      String
  type               VoucherType
  status             VoucherStatus       @default(POSTED)
  voucherDate        DateTime            @db.Date
  narration          String?
  idempotencyKey     String
  requestHash        String
  createdById        String?
  createdAt          DateTime            @default(now())
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy          User?               @relation("VoucherCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lines              VoucherLine[]
  inventoryMovements InventoryMovement[]

  @@unique([companyId, id])
  @@unique([companyId, voucherNumber])
  @@unique([companyId, idempotencyKey])
  @@index([companyId, type, voucherDate])
  @@index([companyId, status, voucherDate])
}

model VoucherLine {
  id          String            @id @default(cuid())
  companyId   String
  voucherId   String
  ledgerId    String
  description String?
  debit       Decimal           @default(0) @db.Decimal(18, 2)
  credit      Decimal           @default(0) @db.Decimal(18, 2)
  createdAt   DateTime          @default(now())
  voucher     AccountingVoucher @relation(fields: [companyId, voucherId], references: [companyId, id], onDelete: Restrict)
  ledger      Ledger            @relation(fields: [companyId, ledgerId], references: [companyId, id], onDelete: Restrict)
  billDetails BillWiseOpening[]

  @@unique([companyId, id])
  @@index([companyId, ledgerId, voucherId])
  @@index([companyId, voucherId])
}

model BillWiseOpening {
  id              String      @id @default(cuid())
  companyId       String
  voucherLineId   String
  referenceNumber String
  dueDate         DateTime    @db.Date
  amount          Decimal     @db.Decimal(18, 2)
  createdAt       DateTime    @default(now())
  voucherLine     VoucherLine @relation(fields: [companyId, voucherLineId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, voucherLineId, referenceNumber])
  @@index([companyId, dueDate])
}

model StockGroup {
  id          String       @id @default(cuid())
  companyId   String
  parentId    String?
  name        String
  code        String
  description String?
  isSystem    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent      StockGroup?  @relation("StockGroupTree", fields: [companyId, parentId], references: [companyId, id], onDelete: Restrict)
  children    StockGroup[] @relation("StockGroupTree")
  items       StockItem[]

  @@unique([companyId, id])
  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId, parentId])
}

model UnitOfMeasure {
  id              String               @id @default(cuid())
  companyId       String
  name            String
  symbol          String
  precision       Int                  @default(3)
  isSystem        Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  company         Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversions     UnitConversion[]     @relation("UnitConversionFrom")
  convertedTo     UnitConversion[]     @relation("UnitConversionTo")
  itemBaseUnits   StockItem[]          @relation("ItemBaseUnit")
  itemConversions ItemUnitConversion[]

  @@unique([companyId, id])
  @@unique([companyId, name])
  @@unique([companyId, symbol])
  @@index([companyId, name])
}

model UnitConversion {
  id         String        @id @default(cuid())
  companyId  String
  fromUnitId String
  toUnitId   String
  factor     Decimal       @db.Decimal(18, 8)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromUnit   UnitOfMeasure @relation("UnitConversionFrom", fields: [companyId, fromUnitId], references: [companyId, id], onDelete: Restrict)
  toUnit     UnitOfMeasure @relation("UnitConversionTo", fields: [companyId, toUnitId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, fromUnitId, toUnitId])
  @@index([companyId, toUnitId])
}

model ItemUnitConversion {
  id           String        @id @default(cuid())
  companyId    String
  itemId       String
  unitId       String
  baseQuantity Decimal       @db.Decimal(18, 8)
  barcode      String?
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  item         StockItem     @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: Cascade)
  unit         UnitOfMeasure @relation(fields: [companyId, unitId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, itemId, unitId])
  @@unique([companyId, barcode])
  @@index([companyId, unitId])
}

model Warehouse {
  id        String              @id @default(cuid())
  companyId String
  parentId  String?
  name      String
  code      String
  address   String?
  isSystem  Boolean             @default(false)
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent    Warehouse?          @relation("WarehouseTree", fields: [companyId, parentId], references: [companyId, id], onDelete: Restrict)
  children  Warehouse[]         @relation("WarehouseTree")
  balances  StockBalance[]
  movements InventoryMovement[]
  batches   InventoryBatch[]

  @@unique([companyId, id])
  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId, parentId, isActive])
}

model StockItem {
  id             String               @id @default(cuid())
  companyId      String
  groupId        String
  baseUnitId     String
  name           String
  code           String?
  hsnSac         String?
  gstRate        Decimal              @default(0) @db.Decimal(5, 2)
  purchaseRate   Decimal              @default(0) @db.Decimal(18, 4)
  salesRate      Decimal              @default(0) @db.Decimal(18, 4)
  mrp            Decimal?             @db.Decimal(18, 4)
  reorderLevel   Decimal              @default(0) @db.Decimal(18, 6)
  minimumLevel   Decimal              @default(0) @db.Decimal(18, 6)
  maximumLevel   Decimal?             @db.Decimal(18, 6)
  batchTracked   Boolean              @default(false)
  barcode        String?
  isActive       Boolean              @default(true)
  creationKey    String
  creationHash   String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  company        Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  group          StockGroup           @relation(fields: [companyId, groupId], references: [companyId, id], onDelete: Restrict)
  baseUnit       UnitOfMeasure        @relation("ItemBaseUnit", fields: [companyId, baseUnitId], references: [companyId, id], onDelete: Restrict)
  alternateUnits ItemUnitConversion[]
  batches        InventoryBatch[]
  balances       StockBalance[]
  movements      InventoryMovement[]

  @@unique([companyId, id])
  @@unique([companyId, name])
  @@unique([companyId, code])
  @@unique([companyId, barcode])
  @@unique([companyId, creationKey])
  @@index([companyId, groupId, isActive, name])
  @@index([companyId, baseUnitId])
  @@index([companyId, hsnSac])
  @@index([companyId, batchTracked, isActive])
}

model InventoryBatch {
  id                String              @id @default(cuid())
  companyId         String
  itemId            String
  warehouseId       String
  batchNumber       String
  manufacturingDate DateTime?           @db.Date
  expiryDate        DateTime?           @db.Date
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  company           Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  item              StockItem           @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: Restrict)
  warehouse         Warehouse           @relation(fields: [companyId, warehouseId], references: [companyId, id], onDelete: Restrict)
  balances          StockBalance[]
  movements         InventoryMovement[]

  @@unique([companyId, id])
  @@unique([companyId, itemId, warehouseId, batchNumber])
  @@index([companyId, itemId, expiryDate])
  @@index([companyId, warehouseId, expiryDate])
}

model StockBalance {
  id          String          @id @default(cuid())
  companyId   String
  itemId      String
  warehouseId String
  batchId     String?
  locationKey String
  quantity    Decimal         @default(0) @db.Decimal(18, 6)
  value       Decimal         @default(0) @db.Decimal(18, 4)
  updatedAt   DateTime        @updatedAt
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  item        StockItem       @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: Restrict)
  warehouse   Warehouse       @relation(fields: [companyId, warehouseId], references: [companyId, id], onDelete: Restrict)
  batch       InventoryBatch? @relation(fields: [companyId, batchId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, itemId, warehouseId, locationKey])
  @@index([companyId, warehouseId, itemId])
  @@index([companyId, itemId, quantity])
}

model InventoryMovement {
  id             String                @id @default(cuid())
  companyId      String
  itemId         String
  warehouseId    String
  batchId        String?
  voucherId      String?
  movementType   InventoryMovementType
  direction      InventoryDirection
  quantity       Decimal               @db.Decimal(18, 6)
  unitCost       Decimal               @db.Decimal(18, 4)
  value          Decimal               @db.Decimal(18, 4)
  movementDate   DateTime              @db.Date
  idempotencyKey String
  requestHash    String
  createdById    String?
  createdAt      DateTime              @default(now())
  company        Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  item           StockItem             @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: Restrict)
  warehouse      Warehouse             @relation(fields: [companyId, warehouseId], references: [companyId, id], onDelete: Restrict)
  batch          InventoryBatch?       @relation(fields: [companyId, batchId], references: [companyId, id], onDelete: Restrict)
  voucher        AccountingVoucher?    @relation(fields: [companyId, voucherId], references: [companyId, id], onDelete: Restrict)
  createdBy      User?                 @relation("InventoryMovementCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([companyId, idempotencyKey])
  @@index([companyId, itemId, movementDate, id])
  @@index([companyId, warehouseId, movementDate])
  @@index([companyId, batchId, movementDate])
  @@index([companyId, voucherId])
}

model Membership {
  id        String           @id @default(cuid())
  userId    String
  companyId String
  status    MembershipStatus @default(ACTIVE)
  isDefault Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roles     MembershipRole[]

  @@unique([userId, companyId])
  @@index([companyId, status])
  @@index([userId, status])
}

model Role {
  id          String           @id @default(cuid())
  companyId   String
  name        String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships MembershipRole[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Permission {
  id          String           @id @default(cuid())
  resource    String
  action      String
  description String?
  roles       RolePermission[]

  @@unique([resource, action])
  @@index([resource])
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model MembershipRole {
  membershipId String
  roleId       String
  createdAt    DateTime   @default(now())
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@index([roleId])
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  actorId    String?
  action     String
  entityType String
  entityId   String?
  changes    Json?
  reason     String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId])
  @@index([actorId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model OtpChallenge {
  id         String     @id @default(cuid())
  userId     String
  purpose    OtpPurpose
  codeHash   String
  expiresAt  DateTime
  attempts   Int        @default(0)
  consumedAt DateTime?
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  companyId String?
  count     Int      @default(1)
  resetAt   DateTime
  createdAt DateTime @default(now())
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([resetAt])
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  ipAddress String?
  userAgent String?
  success   Boolean
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AuthSession {
  id        String    @id @default(cuid())
  tokenId   String    @unique
  userId    String
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, revokedAt])
}
