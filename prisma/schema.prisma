generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Locale {
  EN
  HI
  BILINGUAL
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum OtpPurpose {
  LOGIN
}

enum FinancialYearStatus {
  OPEN
  CLOSED
}

enum PartyType {
  CUSTOMER
  SUPPLIER
}

enum LedgerType {
  GENERAL
  CASH
  BANK
  TAX
  INCOME
  EXPENSE
  PARTY
}

enum AccountNature {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum VoucherType {
  OPENING_BALANCE
  JOURNAL
  SALES
  PURCHASE
  PAYMENT
  RECEIPT
  CONTRA
  SALES_RETURN
  CREDIT_NOTE
  DEBIT_NOTE
}

enum PaymentMethod {
  CASH
  BANK
  CHEQUE
  UPI
  NEFT
  RTGS
}

enum VoucherStatus {
  DRAFT
  POSTED
  CANCELLED
  REVERSED
}

enum VoucherApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum VoucherTaxType {
  CGST
  SGST
  UTGST
  IGST
  CESS
  TDS
  TCS
  OTHER
}

enum BillReferenceType {
  NEW
  AGAINST_REF
  ON_ACCOUNT
}

enum DayBookEventType {
  DRAFT_CREATED
  DRAFT_UPDATED
  APPROVAL_REQUESTED
  APPROVED
  REJECTED
  POSTED
  CANCELLED
  REVERSED
}

enum VoucherAuditAction {
  CREATED
  UPDATED
  APPROVAL_REQUESTED
  APPROVED
  REJECTED
  POSTED
  CANCELLED
  REVERSED
}

enum InventoryMovementType {
  OPENING
  PURCHASE
  SALES
  SALES_RETURN
  PURCHASE_RETURN
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  PRODUCTION_IN
  PRODUCTION_OUT
  JOB_WORK_IN
  JOB_WORK_OUT
}

enum InventoryDirection {
  IN
  OUT
}

enum SalesDocumentType {
  QUOTATION
  SALES_ORDER
  DELIVERY_NOTE
  SALES_INVOICE
}

enum SalesDocumentStatus {
  DRAFT
  ISSUED
  ACCEPTED
  REJECTED
  PARTIALLY_DELIVERED
  DELIVERED
  PARTIALLY_INVOICED
  INVOICED
  POSTED
  CANCELLED
  REVERSED
}

enum SalesPaymentMode {
  CASH
  CREDIT
}

enum SalesInvoiceNature {
  GOODS
  SERVICE
}

enum SalesDocumentEventType {
  CREATED
  ISSUED
  ACCEPTED
  REJECTED
  ORDER_CREATED
  DELIVERY_POSTED
  INVOICE_POSTED
  CANCELLED
  REVERSED
  EMAIL_SENT
  WHATSAPP_SENT
}

enum PurchaseDocumentType {
  PURCHASE_ORDER
  RECEIPT_NOTE
  PURCHASE_INVOICE
  PURCHASE_RETURN
}

enum PurchaseDocumentStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  PARTIALLY_INVOICED
  INVOICED
  POSTED
  CANCELLED
  REVERSED
}

enum PurchasePaymentMode {
  CASH
  CREDIT
}

enum PurchaseDocumentEventType {
  CREATED
  ORDERED
  RECEIPT_POSTED
  INVOICE_POSTED
  RETURN_POSTED
  CANCELLED
  REVERSED
}

model User {
  id                       String                  @id @default(cuid())
  email                    String                  @unique
  normalizedEmail          String                  @unique
  name                     String?
  mobile                   String?                 @unique
  passwordHash             String
  locale                   Locale                  @default(EN)
  emailVerifiedAt          DateTime?
  failedLoginCount         Int                     @default(0)
  lockedUntil              DateTime?
  sessionVersion           Int                     @default(0)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  memberships              Membership[]
  resetTokens              PasswordResetToken[]
  otpChallenges            OtpChallenge[]
  auditLogs                AuditLog[]              @relation("AuditActor")
  loginHistory             LoginHistory[]
  authSessions             AuthSession[]
  accountingVouchers       AccountingVoucher[]     @relation("VoucherCreator")
  postedVouchers           AccountingVoucher[]     @relation("VoucherPoster")
  cancelledVouchers        AccountingVoucher[]     @relation("VoucherCanceller")
  inventoryMovements       InventoryMovement[]     @relation("InventoryMovementCreator")
  voucherApprovals         VoucherApprovalAction[] @relation("VoucherApprovalActor")
  voucherAuditEvents       VoucherAuditEvent[]     @relation("VoucherAuditActor")
  dayBookEvents            DayBookEntry[]          @relation("DayBookActor")
  voucherAttachments       VoucherAttachment[]     @relation("VoucherAttachmentCreator")
  salesDocumentsCreated    SalesDocument[]         @relation("SalesDocumentCreator")
  salesDocumentsIssued     SalesDocument[]         @relation("SalesDocumentIssuer")
  salesDocumentEvents      SalesDocumentEvent[]    @relation("SalesDocumentEventActor")
  purchaseDocumentsCreated PurchaseDocument[]      @relation("PurchaseDocumentCreator")
  purchaseDocumentsIssued  PurchaseDocument[]      @relation("PurchaseDocumentIssuer")
  purchaseDocumentEvents   PurchaseDocumentEvent[] @relation("PurchaseDocumentEventActor")

  @@index([mobile])
}

model Company {
  id                      String                  @id @default(cuid())
  name                    String
  legalName               String?
  gstin                   String?                 @unique
  pan                     String?
  addressLine1            String?
  addressLine2            String?
  city                    String?
  state                   String?
  stateCode               String?
  postalCode              String?
  country                 String                  @default("India")
  email                   String?
  phone                   String?
  website                 String?
  logoUrl                 String?
  booksBeginningDate      DateTime?               @db.Date
  financialYearStartMonth Int                     @default(4)
  timezone                String                  @default("Asia/Kolkata")
  currency                String                  @default("INR")
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  memberships             Membership[]
  roles                   Role[]
  financialYears          FinancialYear[]
  auditLogs               AuditLog[]
  rateLimits              RateLimit[]
  parties                 Party[]
  ledgerGroups            LedgerGroup[]
  ledgers                 Ledger[]
  accountingVouchers      AccountingVoucher[]
  voucherNumberSeries     VoucherNumberSeries[]
  ledgerTransactions      LedgerTransaction[]
  taxTransactions         TaxTransaction[]
  billWiseEntries         BillWiseEntry[]
  costCentres             CostCentre[]
  voucherAttachments      VoucherAttachment[]
  voucherApprovals        VoucherApprovalAction[]
  voucherAuditEvents      VoucherAuditEvent[]
  dayBookEntries          DayBookEntry[]
  stockGroups             StockGroup[]
  units                   UnitOfMeasure[]
  unitConversions         UnitConversion[]
  stockItems              StockItem[]
  warehouses              Warehouse[]
  batches                 InventoryBatch[]
  stockBalances           StockBalance[]
  inventoryMovements      InventoryMovement[]
  itemConversions         ItemUnitConversion[]
  CostAllocation          CostAllocation[]
  salesNumberSeries       SalesNumberSeries[]
  salesDocuments          SalesDocument[]
  salesDocumentLines      SalesDocumentLine[]
  salesDocumentEvents     SalesDocumentEvent[]
  purchaseNumberSeries    PurchaseNumberSeries[]
  purchaseDocuments       PurchaseDocument[]
  purchaseDocumentLines   PurchaseDocumentLine[]
  purchaseDocumentEvents  PurchaseDocumentEvent[]

  @@index([name])
  @@index([pan])
  @@index([stateCode])
}

model FinancialYear {
  id                 String                @id @default(cuid())
  companyId          String
  name               String
  startDate          DateTime              @db.Date
  endDate            DateTime              @db.Date
  booksBeginningDate DateTime              @db.Date
  status             FinancialYearStatus   @default(OPEN)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  company            Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vouchers           AccountingVoucher[]
  numberSeries       VoucherNumberSeries[]

  @@unique([companyId, id])
  @@unique([companyId, startDate])
  @@index([companyId, status, startDate])
  @@index([companyId, endDate])
}

model Party {
  id                String             @id @default(cuid())
  companyId         String
  type              PartyType
  name              String
  contactName       String?
  email             String?
  phone             String?
  mobile            String?
  gstin             String?
  pan               String?
  addressLine1      String?
  addressLine2      String?
  city              String?
  state             String?
  stateCode         String?
  postalCode        String?
  country           String             @default("India")
  creditPeriodDays  Int                @default(0)
  creditLimit       Decimal            @default(0) @db.Decimal(18, 2)
  isActive          Boolean            @default(true)
  creationKey       String
  creationHash      String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ledger            Ledger?
  salesDocuments    SalesDocument[]
  purchaseDocuments PurchaseDocument[]

  @@unique([companyId, id])
  @@unique([companyId, creationKey])
  @@unique([companyId, gstin])
  @@index([companyId, type, isActive, name])
  @@index([companyId, pan])
  @@index([companyId, stateCode])
}

model LedgerGroup {
  id        String        @id @default(cuid())
  companyId String
  parentId  String?
  name      String
  code      String
  nature    AccountNature
  isSystem  Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent    LedgerGroup?  @relation("LedgerGroupTree", fields: [companyId, parentId], references: [companyId, id], onDelete: Restrict)
  children  LedgerGroup[] @relation("LedgerGroupTree")
  ledgers   Ledger[]

  @@unique([companyId, id])
  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId, parentId])
  @@index([companyId, nature])
}

model Ledger {
  id                       String              @id @default(cuid())
  companyId                String
  groupId                  String
  partyId                  String?
  name                     String
  code                     String?
  type                     LedgerType          @default(GENERAL)
  isSystem                 Boolean             @default(false)
  costCentreEnabled        Boolean             @default(false)
  interestEnabled          Boolean             @default(false)
  interestRate             Decimal?            @db.Decimal(7, 4)
  isActive                 Boolean             @default(true)
  creationKey              String
  creationHash             String
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  company                  Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  group                    LedgerGroup         @relation(fields: [companyId, groupId], references: [companyId, id], onDelete: Restrict)
  party                    Party?              @relation(fields: [companyId, partyId], references: [companyId, id], onDelete: Restrict)
  voucherLines             VoucherLine[]
  transactions             LedgerTransaction[]
  taxTransactions          TaxTransaction[]
  voucherTaxDetails        VoucherTaxDetail[]
  salesPaymentDocuments    SalesDocument[]     @relation("SalesPaymentLedger")
  purchasePaymentDocuments PurchaseDocument[]  @relation("PurchasePaymentLedger")

  @@unique([companyId, id])
  @@unique([companyId, name])
  @@unique([companyId, code])
  @@unique([companyId, partyId])
  @@unique([companyId, creationKey])
  @@index([companyId, groupId, isActive, name])
  @@index([companyId, type, isActive])
}

model VoucherNumberSeries {
  id               String              @id @default(cuid())
  companyId        String
  voucherType      VoucherType
  financialYearId  String?
  periodKey        String
  prefix           String
  suffix           String              @default("")
  nextNumber       Int                 @default(1)
  padding          Int                 @default(5)
  requiresApproval Boolean             @default(false)
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  company          Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialYear    FinancialYear?      @relation(fields: [companyId, financialYearId], references: [companyId, id], onDelete: Restrict)
  vouchers         AccountingVoucher[]

  @@unique([companyId, id])
  @@unique([companyId, voucherType, periodKey])
  @@index([companyId, financialYearId, isActive])
}

model AccountingVoucher {
  id                   String                  @id @default(cuid())
  companyId            String
  voucherNumber        String
  type                 VoucherType
  status               VoucherStatus           @default(POSTED)
  approvalStatus       VoucherApprovalStatus   @default(NOT_REQUIRED)
  voucherDate          DateTime                @db.Date
  financialYearId      String?
  numberSeriesId       String?
  narration            String?
  paymentMethod        PaymentMethod?
  paymentReference     String?
  paymentDate          DateTime?               @db.Date
  paymentBank          String?
  idempotencyKey       String
  requestHash          String
  postIdempotencyKey   String?
  postRequestHash      String?
  cancelIdempotencyKey String?
  cancelRequestHash    String?
  reversalOfId         String?
  createdById          String?
  postedById           String?
  postedAt             DateTime?
  cancelledById        String?
  cancelledAt          DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  company              Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  financialYear        FinancialYear?          @relation(fields: [companyId, financialYearId], references: [companyId, id], onDelete: Restrict)
  numberSeries         VoucherNumberSeries?    @relation(fields: [companyId, numberSeriesId], references: [companyId, id], onDelete: Restrict)
  createdBy            User?                   @relation("VoucherCreator", fields: [createdById], references: [id], onDelete: SetNull)
  postedBy             User?                   @relation("VoucherPoster", fields: [postedById], references: [id], onDelete: SetNull)
  cancelledBy          User?                   @relation("VoucherCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  lines                VoucherLine[]
  inventoryMovements   InventoryMovement[]
  ledgerTransactions   LedgerTransaction[]
  taxTransactions      TaxTransaction[]
  billWiseEntries      BillWiseEntry[]
  costAllocations      CostAllocation[]
  attachments          VoucherAttachment[]
  approvals            VoucherApprovalAction[]
  auditEvents          VoucherAuditEvent[]
  dayBookEntries       DayBookEntry[]
  salesDocuments       SalesDocument[]
  purchaseDocuments    PurchaseDocument[]
  reversalOf           AccountingVoucher?      @relation("VoucherReversal", fields: [companyId, reversalOfId], references: [companyId, id], onDelete: Restrict)
  reversals            AccountingVoucher[]     @relation("VoucherReversal")

  @@unique([companyId, id])
  @@unique([companyId, voucherNumber])
  @@unique([companyId, idempotencyKey])
  @@unique([companyId, postIdempotencyKey])
  @@unique([companyId, cancelIdempotencyKey])
  @@unique([companyId, reversalOfId])
  @@unique([companyId, paymentReference])
  @@index([companyId, type, voucherDate])
  @@index([companyId, status, voucherDate])
  @@index([companyId, financialYearId, status])
  @@index([companyId, approvalStatus, createdAt])
}

model VoucherLine {
  id               String               @id @default(cuid())
  companyId        String
  voucherId        String
  ledgerId         String
  lineNumber       Int                  @default(1)
  description      String?
  debit            Decimal              @default(0) @db.Decimal(18, 2)
  credit           Decimal              @default(0) @db.Decimal(18, 2)
  createdAt        DateTime             @default(now())
  voucher          AccountingVoucher    @relation(fields: [companyId, voucherId], references: [companyId, id], onDelete: Restrict)
  ledger           Ledger               @relation(fields: [companyId, ledgerId], references: [companyId, id], onDelete: Restrict)
  billDetails      BillWiseOpening[]
  billEntries      BillWiseEntry[]
  taxDetails       VoucherTaxDetail[]
  taxTransactions  TaxTransaction[]
  costAllocations  CostAllocation[]
  inventoryDetails VoucherStockDetail[]
  transactions     LedgerTransaction[]

  @@unique([companyId, id])
  @@unique([companyId, voucherId, lineNumber])
  @@index([companyId, ledgerId, voucherId])
  @@index([companyId, voucherId])
}

model LedgerTransaction {
  id              String            @id @default(cuid())
  companyId       String
  voucherId       String
  voucherLineId   String
  ledgerId        String
  transactionDate DateTime          @db.Date
  debit           Decimal           @db.Decimal(18, 2)
  credit          Decimal           @db.Decimal(18, 2)
  createdAt       DateTime          @default(now())
  company         Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  voucher         AccountingVoucher @relation(fields: [companyId, voucherId], references: [companyId, id], onDelete: Restrict)
  voucherLine     VoucherLine       @relation(fields: [companyId, voucherLineId], references: [companyId, id], onDelete: Restrict)
  ledger          Ledger            @relation(fields: [companyId, ledgerId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, voucherLineId])
  @@index([companyId, ledgerId, transactionDate, id])
  @@index([companyId, voucherId])
}

model VoucherTaxDetail {
  id            String         @id @default(cuid())
  companyId     String
  voucherLineId String
  taxLedgerId   String
  taxType       VoucherTaxType
  taxableAmount Decimal        @db.Decimal(18, 2)
  taxAmount     Decimal        @db.Decimal(18, 2)
  rate          Decimal        @db.Decimal(7, 4)
  line          VoucherLine    @relation(fields: [companyId, voucherLineId], references: [companyId, id], onDelete: Restrict)
  taxLedger     Ledger         @relation(fields: [companyId, taxLedgerId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@index([companyId, voucherLineId])
}

model TaxTransaction {
  id              String            @id @default(cuid())
  companyId       String
  voucherId       String
  voucherLineId   String
  ledgerId        String
  taxType         VoucherTaxType
  taxableAmount   Decimal           @db.Decimal(18, 2)
  taxAmount       Decimal           @db.Decimal(18, 2)
  rate            Decimal           @db.Decimal(7, 4)
  transactionDate DateTime          @db.Date
  isReversal      Boolean           @default(false)
  createdAt       DateTime          @default(now())
  company         Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  voucher         AccountingVoucher @relation(fields: [companyId, voucherId], references: [companyId, id], onDelete: Restrict)
  voucherLine     VoucherLine       @relation(fields: [companyId, voucherLineId], references: [companyId, id], onDelete: Restrict)
  ledger          Ledger            @relation(fields: [companyId, ledgerId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, voucherLineId, taxType])
  @@index([companyId, transactionDate, taxType])
  @@index([companyId, ledgerId, transactionDate])
}

model BillWiseEntry {
  id              String            @id @default(cuid())
  companyId       String
  voucherId       String
  voucherLineId   String
  settlesEntryId  String?
  settlesOpeningId String?
  referenceType   BillReferenceType
  referenceNumber String?
  dueDate         DateTime?         @db.Date
  amount          Decimal           @db.Decimal(18, 2)
  settledAmount   Decimal           @default(0) @db.Decimal(18, 2)
  remainingAmount Decimal           @default(0) @db.Decimal(18, 2)
  createdAt       DateTime          @default(now())
  company         Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  voucher         AccountingVoucher @relation(fields: [companyId, voucherId], references: [companyId, id], onDelete: Restrict)
  voucherLine     VoucherLine       @relation(fields: [companyId, voucherLineId], references: [companyId, id], onDelete: Restrict)
  settlesEntry    BillWiseEntry?    @relation("BillEntrySettlement", fields: [companyId, settlesEntryId], references: [companyId, id], onDelete: Restrict)
  settlements     BillWiseEntry[]   @relation("BillEntrySettlement")
  settlesOpening  BillWiseOpening?  @relation("OpeningBillSettlement", fields: [companyId, settlesOpeningId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@index([companyId, referenceNumber])
  @@index([companyId, dueDate])
  @@index([companyId, voucherId])
  @@index([companyId, settlesEntryId])
  @@index([companyId, settlesOpeningId])
  @@index([companyId, remainingAmount, dueDate])
}

model CostCentre {
  id            String                 @id @default(cuid())
  companyId     String
  name          String
  code          String
  isActive      Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  company       Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  allocations   CostAllocation[]
  purchaseLines PurchaseDocumentLine[]

  @@unique([companyId, id])
  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId, isActive, name])
}

model CostAllocation {
  id            String            @id @default(cuid())
  companyId     String
  voucherId     String
  voucherLineId String
  costCentreId  String
  amount        Decimal           @db.Decimal(18, 2)
  createdAt     DateTime          @default(now())
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  voucher       AccountingVoucher @relation(fields: [companyId, voucherId], references: [companyId, id], onDelete: Restrict)
  voucherLine   VoucherLine       @relation(fields: [companyId, voucherLineId], references: [companyId, id], onDelete: Restrict)
  costCentre    CostCentre        @relation(fields: [companyId, costCentreId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, id])
  @@index([companyId, costCentreId, voucherId])
  @@index([companyId, voucherLineId])
}

model VoucherStockDetail {
  id                String                @id @default(cuid())
  companyId         String
  voucherLineId     String
  itemId            String
  warehouseId       String
  batchNumber       String?
  manufacturingDate DateTime?             @db.Date
  expiryDate        DateTime?             @db.Date
  movementType      InventoryMovementType
  direction         InventoryDirection
  quantity          Decimal               @db.Decimal(18, 6)
  unitCost          Decimal               @db.Decimal(18, 4)
  line              VoucherLine           @relation(fields: [companyId, voucherLineId], references: [companyId, id], onDelete: Restrict)
  item              StockItem             @relation(fields: [companyId, itemId], references: [companyId, id], onDelete: Restrict)
  warehouse         Warehouse             @relation(fields: [companyId, warehouseId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, voucherLineId])
  @@index([companyId, itemId, warehouseId])
}

model VoucherAttachment {
  id          String            @id @default(cuid())
  companyId   String
  voucherId   String
  objectKey   String
  url         String
  fileName    String
  contentType String
  byteSize    Int
  createdById String?
  createdAt   DateTime          @default(now())
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  voucher     AccountingVoucher @relation(fields: [companyId, voucherId], references: [companyId, id], onDelete: Restrict)
  createdBy   User?             @relation("VoucherAttachmentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([companyId, id])
  @@unique([companyId, objectKey])
  @@index([companyId, voucherId])
}

model VoucherApprovalAction {
  id             String                @id @default(cuid())
  companyId      String
  voucherId      String
  actorId        String
  decision       VoucherApprovalStatus
  idempotencyKey String
  reason         String?
  createdAt      DateTime              @default(now())
  company        Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  voucher        AccountingVoucher     @relation(fields: [companyId, voucherId], references: [companyId, id], onDelete: Restrict)
  actor          User                  @relation("VoucherApprovalActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([companyId, id])
  @@unique([companyId, idempotencyKey])
  @@index([companyId, voucherId, createdAt])
}

model VoucherAuditEvent {
  id        String             @id @default(cuid())
  companyId String
  voucherId String
  actorId   String?
  action    VoucherAuditAction
  snapshot  Json
  createdAt DateTime           @default(now())
  company   Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  voucher   AccountingVoucher  @relation(fields: [companyId, voucherId], references: [companyId, id], onDelete: Restrict)
  actor     User?              @relation("VoucherAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([companyId, id])
  @@index([companyId, voucherId, createdAt])
}

model DayBookEntry {
  id            String            @id @default(cuid())
  companyId     String
  voucherId     String
  actorId       String?
  eventType     DayBookEventType
  voucherType   VoucherType
  voucherNumber String
  voucherDate   DateTime          @db.Date
  narration     String?
  createdAt     DateTime          @default(now())
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
